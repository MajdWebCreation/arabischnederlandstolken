# Supabase project configuration (Project Settings > API in the Supabase
# dashboard). NEXT_PUBLIC_SUPABASE_ANON_KEY accepts either the "anon
# public" key (older projects) or the "publishable" key (newer projects) -
# both are safe to use here, protected entirely by Row Level Security.
# There is no service role key anywhere in this application on purpose.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_or_publishable_key

# Server-only Resend configuration for the contact form.
RESEND_API_KEY=re_replace_with_resend_api_key
CONTACT_FORM_TO_EMAIL=info@arabischnederlandstolken.nl
CONTACT_FORM_FROM_EMAIL=Arabisch Nederlands Tolkencollectief <contact@send.arabischnederlandstolken.nl>

# Server-only Mollie API key, used only to create Payment Links for issued
# invoices ("Factuur verzenden") - never exposed to the browser, never
# stored in the database. Start with a Mollie *test* key (test_...) while
# building/testing; the same integration works unchanged once this is
# replaced with the live key (live_...).
MOLLIE_API_KEY=test_replace_with_mollie_test_api_key
